# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Elasticsearch BM25 (run and populate via: python -m src.task6_lexical_search)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
BM25_LOCAL_FALLBACK=true

# Weighted RRF: dense 70%, BM25 30% (raw scores are not mixed)
HYBRID_WEIGHTED_ENABLED=true
HYBRID_DENSE_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3

# OpenAI text-embedding-3-large is active; enable E5 after indexing its collection.
DENSE_BACKEND=shared
MULTI_DENSE_ENABLED=false
E5_MODEL=intfloat/multilingual-e5-large
E5_COLLECTION_NAME=rag_documents_e5

# One OpenAI call creates Vietnamese and English retrieval queries
QUERY_FORMULATION_ENABLED=false
QUERY_FORMULATION_MODEL=gpt-4.1-mini

# Optional Cohere rerank after RRF
COHERE_RERANK_ENABLED=false
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
